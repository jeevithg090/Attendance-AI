# ─── API server ────────────────────────────────────────────────
# Neon (or any PostgreSQL) connection string.
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

# Comma-separated origins allowed by CORS (your deployed frontend, e.g. https://your-app.vercel.app).
# http://localhost:5173 and :4173 are allowed automatically outside production.
FRONTEND_URL=

# Number of reverse proxies in front of the API (set to 1 on Railway/Render/Fly) so req.ip is correct.
TRUST_PROXY=0

# Set to "false" to disable the background jobs (token rotation, auto-closing expired sessions).
ENABLE_CRON=true

# Optional: passwords for the demo accounts created by `npm run db:seed`.
# Required when NODE_ENV=production; demo defaults are used otherwise.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# ─── Frontend (Vite, exposed to the browser) ───────────────────
# API base URL. Leave unset in development to use the Vite proxy (/api -> localhost:3001).
VITE_API_URL=
VITE_APP_NAME=AttendAI
# Show one-click demo credentials on the login page (only for demo deployments).
VITE_SHOW_DEMO_LOGINS=false
